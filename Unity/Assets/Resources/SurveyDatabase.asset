      choices: []
      hint:
      - "\uBBF8\uD655\uC778 \uACF5\uAC04 \uC5EC\uC12F \uACF3\uC758 \uC704\uCE58\uC640 \uC21C\uD658\uB85C \uC57C\uC7A5\uC744 \uB300\uC870\uD558\uC138\uC694."
      - "U-6\uC5D0\uC11C \uCD9C\uBC1C\uD558\uC5EC U-3, U-5\uB85C \uB3CC\uC544\uC635\uB2C8\uB2E4."
      - "U-6 \u2192 U-3 \u2192 U-5 \u2192 U-2 \u2192 U-4 \u2192 U-1 \u2192 K-01 \uC21C\uC11C\uC785\uB2C8\uB2E4."
    route:
    - U-6
    - U-3
    - U-5
    - U-2
    - U-4
    - U-1
    - K-01
    endings:
    - id: A
      name: "\uBD80\uBD84 \uC11C\uBA85"
      headline: "\uD655\uC778\uD560 \uC218 \uC5C6\uB294 \uACF3\uC5D0\uB294, \uC120\uC744 \uAE0B\uC9C0 \uC54A\uC558\uB2E4."
      text: "\uCE21\uB7C9 \uBD88\uAC00 \uAD6C\uAC04\uC744 \uB0A8\uAE34 \uC131\uACFC\uB3C4\uAC00 \uC811\uC218\uB418\uC5C8\uB2E4. \uBC1C\uD30C\uB294 \uC5F0\uAE30\uB418\uC5C8\uACE0 \uAD00\uCE21\uC18C\uB294 \uB2E4\uC2DC \uBD09\uC1C4\uB418\uC5C8\uB2E4. \uACF5\uB3D9\uC740 \uC544\uC9C1 \uADF8 \uC544\uB798\uC5D0 \uC788\uB2E4. \uC801\uC5B4\uB3C4 \uC624\uB298\uC740, \uC544\uBB34\uB3C4 \uB4E4\uC5B4\uAC00\uC9C0 \uC54A\uB294\uB2E4."
      after: "\uACF5\uC0AC \uBB34\uAE30\uD55C \uC5F0\uAE30 / \uC2DC\uC124 \uC811\uADFC \uD1B5\uC81C"
    - id: B
      name: "\uC804\uCCB4 \uC11C\uBA85"
      headline: "\uB3C4\uBA74\uC740 \uC644\uC131\uB418\uC5C8\uB2E4. \uD55C \uACF3\uC744 \uC81C\uC678\uD558\uACE0."
      text: "\uAC00\uC7A5 \uADF8\uB7F4\uB4EF\uD55C \uAC12\uB4E4\uC774 \uC131\uACFC\uB3C4\uAC00 \uB418\uC5C8\uB2E4. \uC811\uC218 \uD655\uC778\uC11C\uC5D0\uB294 \uC544\uBB34 \uBB38\uC81C\uB3C4 \uC5C6\uC5C8\uB2E4. \uB2E4\uC74C \uB0A0, \uD604\uC7A5\uC5D0\uC11C\uB294 \uB3C4\uBA74\uC5D0 \uC5C6\uB294 \uBB38 \uD558\uB098\uAC00 \uBC1C\uACAC\uB418\uC5C8\uB2E4. \uBB38\uC740 \uC548\uCABD\uC73C\uB85C \uC5F4\uB824 \uC788\uC5C8\uB2E4."
      after: "\uC131\uACFC\uB3C4 \uC815\uC0C1 \uC811\uC218 / \uCD94\uAC00 \uACF5\uB3D9 \uBC1C\uACAC"
    - id: C
      name: "\uAE30\uC874 \uB3C4\uBA74"
      headline: "\uC885\uC774\uC5D0 \uC5C6\uC73C\uBA74, \uC5C6\uB294 \uAC83\uC73C\uB85C \uD55C\uB2E4."
      text: "1991\uB144 \uB3C4\uBA74\uC5D0 \uB9DE\uCD98 \uC22B\uC790\uAC00 \uC81C\uCD9C\uB418\uC5C8\uB2E4. \uACF5\uB3D9\uC740 \uB808\uC774\uB354\uC5D0\uC11C \uC0AC\uB77C\uC84C\uB2E4. \uC624\uC804 06:00, \uBC1C\uD30C\uAC00 \uC2DC\uC791\uB418\uC5C8\uB2E4. \uC0B0 \uC544\uB798\uC5D0\uC11C \uD55C \uBC88, \uBA40\uB9AC\uC11C \uB4E4\uB824\uC57C \uD560 \uC18C\uB9AC\uAC00 \uBC14\uB85C \uBC1C\uBC11\uC5D0\uC11C \uB0AC\uB2E4."
      after: "\uACF5\uC0AC \uAC15\uD589 / \uC9C0\uBC18 \uCE68\uD558 \uBCF4\uACE0"
    - id: D
      name: "\uD3D0\uD569"
      headline: "\uB9C8\uC9C0\uB9C9 \uC810\uC774, \uCC98\uC74C\uC758 \uC810\uC73C\uB85C \uB3CC\uC544\uC654\uB2E4."
      text: "\uBAA8\uB4E0 \uBBF8\uD655\uC778 \uACF5\uAC04\uC744 \uD3EC\uD568\uD55C \uACE0\uB9AC\uAC00 K-01\uC5D0\uC11C \uB2EB\uD614\uB2E4. \uD5C8\uC6A9 \uC624\uCC28 0.050m, \uCD5C\uC885 \uD3D0\uD569 \uC624\uCC28 0.000m. \uD658\uD48D\uAE30 \uC18C\uB9AC\uAC00 \uB3CC\uC544\uC654\uB2E4. \uACF5\uC0AC \uC911\uB2E8 \uAD8C\uACE0\uC11C\uC640 \uD568\uAED8 \uC131\uACFC\uB3C4\uB97C \uC81C\uCD9C\uD588\uB2E4. \uB300\uD45C\uC5D0\uAC8C\uC11C \uC804\uD654\uAC00 \uC654\uB2E4. \uB2F9\uC2E0\uC740 \uBA3C\uC800 \uC548\uC804\uBAA8\uB97C \uBC97\uC5C8\uB2E4."
      after: "\uD3D0\uD569 \uC644\uB8CC / \uACF5\uC0AC \uC911\uB2E8 \uAD8C\uACE0 / \uCE21\uB7C9\uC790 \uCC45\uC784 \uC11C\uBA85"
    - id: E
      name: "\uCCA0\uC218"
      headline: "\uB2F9\uC2E0\uC758 \uC774\uB984\uC740 \uB0A8\uC9C0 \uC54A\uC558\uB2E4."
      text: "\uC7A5\uBE44\uB97C \uCC59\uACA8 \uC0B0\uC744 \uB0B4\uB824\uC654\uB2E4. \uAC10\uB3C5\uAD00\uC740 \uB2E4\uB978 \uC5C5\uCCB4\uB97C \uBD80\uB974\uACA0\uB2E4\uACE0 \uD588\uB2E4. \uB2E4\uC74C \uB0A0 \uC624\uC804 06:00, \uB3C4\uBA74\uC774 \uC5C6\uB294 \uC9C0\uD558 \uC704\uC5D0\uC11C \uC608\uC815\uB300\uB85C \uC791\uC5C5\uC774 \uC2DC\uC791\uB418\uC5C8\uB2E4. \uB77C\uB514\uC624\uB294 \uADF8 \uB4A4\uC758 \uC77C\uC744 \uC804\uD558\uC9C0 \uC54A\uC558\uB2E4."
      after: "\uBBF8\uC11C\uBA85 \uCCA0\uC218 / \uC608\uC815\uB300\uB85C \uCC29\uACF5"
